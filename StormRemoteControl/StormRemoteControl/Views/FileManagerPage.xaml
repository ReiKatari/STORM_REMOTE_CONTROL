<Page
    x:Class="StormRemoteControl.Views.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Padding="16,10,16,10" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Padding="8,5" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Click="OnBackClicked" ToolTipService.ToolTip="Назад (Escape)">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="13"/>
                </Button>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" Foreground="{StaticResource AccentColorBrush}" FontSize="18"/>
                <TextBlock Text="ФАЙЛОВЫЙ МЕНЕДЖЕР" FontFamily="Century Gothic" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentColorBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- DUAL PANE AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: LOCAL PC -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Pane Header with Refresh + NewFolder in the red bar -->
                <Border Grid.Row="0" Background="{StaticResource AccentColorBrush}" Padding="12,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F8;" FontSize="13" Foreground="White"/>
                            <TextBlock Text="ЛОКАЛЬНЫЙ ПК" FontFamily="Century Gothic" FontWeight="Bold" FontSize="12" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Padding="4,2" Background="Transparent" Click="OnRefreshClicked" ToolTipService.ToolTip="Обновить (Ctrl+R)" MinWidth="28" MinHeight="24">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="11" Foreground="White"/>
                            </Button>
                            <Button Padding="4,2" Background="Transparent" Click="OnNewFolderClicked" ToolTipService.ToolTip="Новая папка (F7)" MinWidth="28" MinHeight="24">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F4;" FontSize="11" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick Access — scrollable with bottom padding for scrollbar -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Padding="0,0,0,6">
                    <StackPanel x:Name="LeftQuickAccess" Orientation="Horizontal" Padding="6,4" Spacing="4" Background="#10FFFFFF"/>
                </ScrollViewer>

                <!-- Path Bar -->
                <Grid Grid.Row="2" Padding="8,4,8,4" Background="#08FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Padding="5,3" Background="Transparent" Click="OnLeftUpClicked" ToolTipService.ToolTip="Вверх (Backspace)">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74A;" FontSize="11"/>
                    </Button>
                    <Button Grid.Column="1" Padding="5,3" Background="Transparent" Click="OnLeftHomeClicked" Margin="2,0">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="11"/>
                    </Button>
                    <TextBox x:Name="LeftPathBox" Grid.Column="2" FontFamily="Century Gothic" FontWeight="Bold" FontSize="11" Padding="6,4" Background="#121215" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" KeyDown="OnLeftPathKeyDown"/>
                    <TextBlock x:Name="ItemCountText" Grid.Column="3" Text="" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                </Grid>

                <!-- Column Headers — centered text, visible separators -->
                <Grid Grid.Row="3" Padding="0" Background="#0D0D10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="8,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"/>
                    <Border Grid.Column="1" Padding="8,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <TextBlock Text="ИМЯ" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentColorBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" Width="1" Background="{StaticResource BorderBrush}"/>
                    <Border Grid.Column="3" Padding="8,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <TextBlock Text="РАЗМЕР" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentColorBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" Width="1" Background="{StaticResource BorderBrush}"/>
                    <Border Grid.Column="5" Padding="8,6">
                        <TextBlock Text="ИЗМЕНЁН" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentColorBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- File List -->
                <ListView x:Name="LeftFileList" Grid.Row="4" SelectionMode="Extended" DoubleTapped="OnLeftDoubleTapped" RightTapped="OnLeftRightTapped" Background="Transparent" AllowDrop="True" CanDragItems="True" DragItemsStarting="OnLeftDragStart" Drop="OnLeftDrop" DragOver="OnDragOver" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="8,6" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding IconGlyph}" FontSize="14" Foreground="{Binding IconColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" Padding="8,6" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
                                    <TextBlock Text="{Binding Name}" FontFamily="Century Gothic" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Border Grid.Column="2" Padding="8,6" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
                                    <TextBlock Text="{Binding SizeDisplay}" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Border>
                                <Border Grid.Column="3" Padding="8,6">
                                    <TextBlock Text="{Binding DateDisplay}" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- CENTER: TRANSFER BUTTONS -->
            <Border Grid.Column="1" Width="48" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0">
                <StackPanel VerticalAlignment="Center" Spacing="8" Padding="4">
                    <Button x:Name="CopyToRemoteBtn" Padding="8" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" Click="OnCopyToRemoteClicked" ToolTipService.ToolTip="Копировать на удалённый (F5)">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72A;" FontSize="14" Foreground="{StaticResource AccentColorBrush}"/>
                    </Button>
                    <Button x:Name="CopyFromRemoteBtn" Padding="8" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" Click="OnCopyFromRemoteClicked" ToolTipService.ToolTip="Копировать с удалённого">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="14" Foreground="{StaticResource AccentColorBrush}"/>
                    </Button>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="4,4"/>
                    <Button Padding="8" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" Click="OnDeleteClicked" ToolTipService.ToolTip="Удалить (F8)">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14" Foreground="#EF5350"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- RIGHT PANE: REMOTE PC -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#333336" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="13" Foreground="White"/>
                        <TextBlock Text="УДАЛЁННЫЙ ПК" FontFamily="Century Gothic" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="#0D0D10">
                    <StackPanel x:Name="RemotePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="42" Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="УДАЛЁННЫЙ ПК НЕ ПОДКЛЮЧЁН" FontFamily="Century Gothic" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Подключитесь к удалённому ПК для доступа к файлам." FontFamily="Century Gothic" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" TextAlignment="Center" MaxWidth="300"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Grid Grid.Row="2" Padding="12,6,12,6" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Text="Готов" Style="{StaticResource StormTextSubtleBoldStyle}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedCountText" Grid.Column="1" Text="" Style="{StaticResource StormTextSubtleBoldStyle}" VerticalAlignment="Center" Foreground="{StaticResource AccentColorBrush}" Margin="0,0,12,0"/>
            <TextBlock x:Name="FreeSpaceText" Grid.Column="2" Text="" Style="{StaticResource StormTextSubtleBoldStyle}" VerticalAlignment="Center"/>
        </Grid>

        <!-- HOTKEY BAR — clickable buttons -->
        <Border Grid.Row="3" Background="#111114" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnHotkeyF3" ToolTipService.ToolTip="Просмотр выбранного файла">
                    <TextBlock Text="F3 Просмотр" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#999"/>
                </Button>
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnHotkeyF5" ToolTipService.ToolTip="Копировать на удалённый ПК">
                    <TextBlock Text="F5 Копировать" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#999"/>
                </Button>
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnHotkeyF6" ToolTipService.ToolTip="Переместить на удалённый ПК">
                    <TextBlock Text="F6 Переместить" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#999"/>
                </Button>
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnNewFolderClicked" ToolTipService.ToolTip="Создать новую папку">
                    <TextBlock Text="F7 Создать папку" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#999"/>
                </Button>
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnDeleteClicked" ToolTipService.ToolTip="Удалить выбранные файлы">
                    <TextBlock Text="F8 Удалить" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#EF5350"/>
                </Button>
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnHotkeyF9" ToolTipService.ToolTip="Переименовать выбранный файл">
                    <TextBlock Text="F9 Переименовать" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#999"/>
                </Button>
                <Button Padding="8,3" Background="#222228" BorderThickness="0" CornerRadius="3" Click="OnRefreshClicked" ToolTipService.ToolTip="Обновить список файлов">
                    <TextBlock Text="Ctrl+R Обновить" FontFamily="Century Gothic" FontWeight="Bold" FontSize="10" Foreground="#999"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
