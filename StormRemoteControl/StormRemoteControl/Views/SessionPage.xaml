<Page
    x:Class="StormRemoteControl.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0A0A0C">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ChatColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Remote Desktop Viewport -->
        <Grid Grid.Column="0" x:Name="ViewportGrid" Background="Black">
            <!-- Real remote display surface — receives decoded JPEG frames -->
            <Image x:Name="RemoteDisplaySurface" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Stream Quality Overlay (Top-Left) -->
            <Border Background="#C0101014" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10,14,10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" Foreground="{StaticResource AccentColorBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FpsTextBlock" Text="0 FPS" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" Foreground="{StaticResource AccentColorBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LatencyTextBlock" Text="-- ms" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE839;" Foreground="{StaticResource AccentColorBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BitrateTextBlock" Text="-- Mbps" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="2,0,2,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EncryptionBadge" Text="AES-256" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="{StaticResource PulsingGreenBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- FLOATING TOOLBAR (Top-Center) -->
            <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Border Background="#E5121216" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8,14,8" Opacity="0.95">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="QualityButton" Content="КАЧЕСТВО" Padding="12,6,12,6">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="СКОРОСТЬ (1280×720, Q40)" Click="OnSpeedModeSelected" FontFamily="Century Gothic" FontWeight="Bold"/>
                                    <MenuFlyoutItem Text="КАЧЕСТВО (NATIVE, Q85)" Click="OnQualityModeSelected" FontFamily="Century Gothic" FontWeight="Bold"/>
                                    <MenuFlyoutItem Text="АВТОМАТИЧЕСКИЙ РЕЖИМ" Click="OnAutoModeSelected" FontFamily="Century Gothic" FontWeight="Bold"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="HotkeysButton" Content="ГОРЯЧИЕ КЛАВИШИ" Padding="12,6,12,6">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Ctrl + Alt + Del" Click="OnCtrlAltDelClick" FontFamily="Century Gothic" FontWeight="Bold"/>
                                    <MenuFlyoutItem Text="Alt + Tab" Click="OnAltTabClick" FontFamily="Century Gothic" FontWeight="Bold"/>
                                    <MenuFlyoutItem Text="Win Key" Click="OnWinKeyClick" FontFamily="Century Gothic" FontWeight="Bold"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="AudioButton" Content="ЗВУК: ВКЛ" Click="OnAudioToggleClick" Padding="12,6,12,6"/>

                        <Button x:Name="FileTransferButton" Content="ФАЙЛЫ" Click="OnFileTransferClick" Padding="12,6,12,6">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="ОТПРАВИТЬ ФАЙЛ..." Click="OnSendFileClick" FontFamily="Century Gothic" FontWeight="Bold"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="ChatToggleButton" Content="ЧАТ" Click="OnChatToggleClick" Padding="12,6,12,6"/>

                        <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="4,0,4,0" VerticalAlignment="Center"/>

                        <Button x:Name="DisconnectButton" Content="ЗАКРЫТЬ" Click="OnDisconnectClick" Background="{StaticResource AccentColorBrush}" Foreground="White" Padding="16,6,16,6">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3D3D"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B71C1C"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- File Transfer Progress Overlay (Bottom-Center) -->
            <Border x:Name="FileTransferOverlay" Visibility="Collapsed" Background="#E5121216" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,12,20,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" MinWidth="350">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" Foreground="{StaticResource AccentColorBrush}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileTransferName" Text="file.zip" Style="{StaticResource StormTextBoldStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FileTransferPercent" Text="0%" Style="{StaticResource StormTextSubtleBoldStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ProgressBar x:Name="FileTransferProgress" Value="0" Maximum="100" Height="4" Foreground="{StaticResource AccentColorBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sidebar Chat Panel -->
        <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Padding="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ЗАЩИЩЁННЫЙ ЧАТ" Style="{StaticResource StormHeaderMediumStyle}" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel x:Name="ChatMessagesStack" Spacing="8"/>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInputBox" PlaceholderText="Сообщение..." KeyDown="OnMessageInputKeyDown" Grid.Column="0" FontFamily="Century Gothic" FontWeight="Bold"/>
                    <Button Content="ОТПР." Click="OnSendMessageClick" Grid.Column="1" Background="{StaticResource AccentColorBrush}" Foreground="White" Padding="12,6,12,6"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
